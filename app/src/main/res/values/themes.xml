<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.QuasarTV" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/color_midnight_background</item>
        <item name="android:statusBarColor">@color/color_midnight_background</item>
        <item name="android:navigationBarColor">@color/color_midnight_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/color_ember_primary</item>
        <item name="android:colorControlNormal">@color/color_muted_text</item>
        <item name="android:colorControlActivated">@color/color_ember_focus</item>
        <item name="android:colorControlHighlight">@color/color_ember_focus</item>
        <item name="android:colorError">@color/color_error</item>
        <item name="android:textColorPrimary">@color/color_warm_ivory_text</item>
        <item name="android:textColorSecondary">@color/color_muted_text</item>
    </style>

    <style name="Theme.QuasarTV.BrandText">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/color_warm_ivory_text</item>
        <item name="android:textSize">@dimen/text_brand</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Theme.QuasarTV.NavigationButton" parent="@android:style/Widget.Material.Button">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/color_warm_ivory_text</item>
        <item name="android:textSize">@dimen/text_navigation</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">@dimen/minimum_action_size</item>
        <item name="android:minHeight">@dimen/minimum_action_size</item>
        <item name="android:paddingStart">@dimen/navigation_action_padding</item>
        <item name="android:paddingEnd">@dimen/navigation_action_padding</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@drawable/nav_rail_action_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Theme.QuasarTV.ClockText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/color_warm_ivory_text</item>
        <item name="android:textSize">@dimen/text_clock</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Theme.QuasarTV.RemoteHintText">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/color_muted_text</item>
        <item name="android:textSize">@dimen/text_hint</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
